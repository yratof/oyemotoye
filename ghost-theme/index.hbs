<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if @page.title}}{{@page.title}} – {{@site.title}}{{else}}{{@site.title}}{{/if}}</title>
  <meta name="description" content="{{#if @page.meta_description}}{{@page.meta_description}}{{else}}{{#if @page.excerpt}}{{@page.excerpt}}{{else}}{{@site.description}}{{/if}}{{/if}}">
  
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  <script defer src="{{asset "js/bundle.js"}}"></script>
  
  {{{meta_head}}}
</head>
<body class="home-template">
  <header class="site-header">
    <nav class="nav">
      <a href="{{@site.url}}" class="site-title">øye mot øye</a>
      <div class="nav-links">
        <a href="{{@site.url}}/">Posts</a>
        <a href="{{@site.url}}/about/">About</a>
      </div>
    </nav>
  </header>
  
  <main class="site-main">
    <div class="post-feed">
      {{#foreach posts}}
      <article class="post-card">
        {{#if feature_image}}
        <a href="{{url}}" class="post-card-image">
          <img src="{{feature_image}}" alt="{{title}}">
        </a>
        {{/if}}
        
        <div class="post-card-content">
          <a href="{{url}}">
            <h2 class="post-card-title">{{title}}</h2>
          </a>
          <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="Do MMMM YYYY"}}</time>
          {{#if excerpt}}
          <p class="post-card-excerpt">{{excerpt}}</p>
          {{/if}}
        </div>
      </article>
      {{/foreach}}
    </div>
    
    {{pagination}}
  </main>
  
  <footer class="site-footer">
    <div class="footer-content">
      <p>© {{year}} øye mot øye</p>
    </div>
  </footer>
</body>
</html>
