<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if @page.title}}{{@page.title}} – {{@site.title}}{{else}}{{@site.title}}{{/if}}</title>
  <meta name="description" content="{{#if @page.meta_description}}{{@page.meta_description}}{{else}}{{#if @page.excerpt}}{{@page.excerpt}}{{else}}{{@site.description}}{{/if}}{{/if}}">
  
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  <script defer src="{{asset "js/bundle.js"}}"></script>
  
  {{{meta_head}}}
</head>
<body class="post-template">
  <header class="site-header">
    <nav class="nav">
      <a href="{{@site.url}}" class="site-title">øye mot øye</a>
      <div class="nav-links">
        <a href="{{@site.url}}/">Posts</a>
        <a href="{{@site.url}}/about/">About</a>
      </div>
    </nav>
  </header>
  
  <main class="site-main">
    <article class="post">
      <header class="post-header">
        <h1 class="post-title">{{@post.title}}</h1>
        {{#if @post.excerpt}}
        <p class="post-excerpt">{{@post.excerpt}}</p>
        {{/if}}
        <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="Do MMMM YYYY"}}</time>
      </header>
      
      {{#if @post.feature_image}}
      <div class="post-hero">
        <img src="{{@post.feature_image}}" alt="{{@post.title}}">
      </div>
      {{/if}}
      
      <div class="post-content">
        {{{@post.mobilediff_html}}}
      </div>
    </article>
    
    {{#if @post.previous_post}}
    <nav class="post-nav">
      <a href="{{@post.previous_post.url}}" class="post-nav-prev">← {{@post.previous_post.title}}</a>
    </nav>
    {{/if}}
  </main>
  
  <footer class="site-footer">
    <div class="footer-content">
      <p>© {{year}} øye mot øye</p>
    </div>
  </footer>
</body>
</html>
