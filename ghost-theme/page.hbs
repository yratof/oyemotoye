<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if @page.title}}{{@page.title}} – {{@site.title}}{{else}}{{@site.title}}{{/if}}</title>
  <meta name="description" content="{{#if @page.meta_description}}{{@page.meta_description}}{{else}}{{#if @page.excerpt}}{{@page.excerpt}}{{else}}{{@site.description}}{{/if}}{{/if}}">
  
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  <script defer src="{{asset "js/bundle.js"}}"></script>
  
  {{{meta_head}}}
</head>
<body class="page-template">
  <header class="site-header">
    <nav class="nav">
      <a href="{{@site.url}}" class="site-title">øye mot øye</a>
      <div class="nav-links">
        <a href="{{@site.url}}/">Posts</a>
        <a href="{{@site.url}}/about/">About</a>
      </div>
    </nav>
  </header>
  
  <main class="site-main">
    {{#if @page.cover}}
    <div class="page-hero">
      <img src="{{@page.cover}}" alt="{{@page.title}}">
    </div>
    {{/if}}
    
    <article class="page-content">
      <h1 class="page-title">{{@page.title}}</h1>
      <div class="page-body">
        {{{@page.mobilediff_html}}}
      </div>
    </article>
  </main>
  
  <footer class="site-footer">
    <div class="footer-content">
      <p>© {{year}} øye mot øye</p>
    </div>
  </footer>
</body>
</html>
